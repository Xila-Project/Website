{
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "docs:validate": "node scripts/check-docs.mjs",
    "test:reference": "node --test tests/reference-path.test.mjs",
    "format:fix": "prettier --write .",
