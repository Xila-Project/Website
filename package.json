    "check": "npm run test:reference && npm run format:check && npm run docs:build && npm run docs:validate"
  },
  "devDependencies": {
    "mermaid": "^12.2.0",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "dependencies": {
    "pagefind": "^1.5.2",
    "vitepress-plugin-pagefind": "^0.4.25",
    "vue": "^3.5.44"
  }
}
